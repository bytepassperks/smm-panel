# SMM Panel - Environment Variables
# Copy this file to .env and update values for your environment

# =====================================================
# Database Configuration
# =====================================================
DB_HOST=10.60.139.53       # Private network IP from Render
DB_PORT=3306
DB_NAME=smm_panel
DB_USER=smm_panel_user
DB_PASS=strong_random_password_here

# =====================================================
# Smmwiz API Configuration
# =====================================================
SMMWIZ_API_KEY=590d78f5f73a1e4a5816fa7c997e0bf6
SMMWIZ_API_URL=https://smmwiz.com/api/v2

# =====================================================
# Site Configuration
# =====================================================
SITE_NAME=SMM Panel
SITE_URL=https://your-smm-panel.onrender.com
SITE_EMAIL=support@yourdomain.com

# =====================================================
# Application Settings
# =====================================================
APP_ENV=production          # development or production
APP_DEBUG=false             # Set to true for debugging
DEFAULT_MARKUP=20.00        # Default markup percentage

# =====================================================
# Security
# =====================================================
JWT_SECRET=generate_a_strong_random_secret_key_here

# =====================================================
# Optional Features
# =====================================================
SHOW_SMMWIZ_BALANCE=false   # Show Smmwiz balance to users